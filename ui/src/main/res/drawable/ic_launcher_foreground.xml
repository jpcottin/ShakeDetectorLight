<?xml version="1.0" encoding="utf-8"?>
<!--
  A shaking Android robot: the classic bugdroid head, tilted a few degrees,
  with motion arcs on both sides. Everything is drawn in the 66dp-diameter
  safe zone of the 108dp adaptive-icon viewport, and the same drawable doubles
  as the monochrome (themed icon) layer — the eyes are cut out with an
  evenOdd path so the silhouette keeps them.

  The Android robot is reproduced or modified from work created and shared by
  Google and used according to terms described in the Creative Commons 3.0
  Attribution License.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Motion arcs, left -->
    <path
        android:pathData="M33,46 A14,14 0 0 0 33,66"
        android:strokeColor="#3DDC84"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M26.5,42 A20,20 0 0 0 26.5,70"
        android:strokeColor="#3DDC84"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />

    <!-- Motion arcs, right -->
    <path
        android:pathData="M75,46 A14,14 0 0 1 75,66"
        android:strokeColor="#3DDC84"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M81.5,42 A20,20 0 0 1 81.5,70"
        android:strokeColor="#3DDC84"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />

    <!-- Bugdroid head, tilted to suggest mid-shake -->
    <group
        android:rotation="8"
        android:pivotX="54"
        android:pivotY="54">
        <!-- Dome with the eyes cut out (evenOdd keeps them in monochrome) -->
        <path
            android:fillColor="#3DDC84"
            android:fillType="evenOdd"
            android:pathData="M37,58 A17,17 0 0 1 71,58 Z
                M46.5,48.3 a2.2,2.2 0 1 1 0,4.4 a2.2,2.2 0 1 1 0,-4.4 Z
                M61.5,48.3 a2.2,2.2 0 1 1 0,4.4 a2.2,2.2 0 1 1 0,-4.4 Z" />
        <!-- Antennae -->
        <path
            android:pathData="M45,44.5 L40.5,38"
            android:strokeColor="#3DDC84"
            android:strokeWidth="2.4"
            android:strokeLineCap="round" />
        <path
            android:pathData="M63,44.5 L67.5,38"
            android:strokeColor="#3DDC84"
            android:strokeWidth="2.4"
            android:strokeLineCap="round" />
    </group>
</vector>
